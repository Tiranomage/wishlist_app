```gitignore
# Dependencies
node_modules/

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Environment
.env
.env.local
*.env.*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Build outputs
dist/
build/
*.min.js
*.min.css
*.bundle.js

# OS generated files
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Cache directories
.mypy_cache/
.pytest_cache/
.nyc_output/
```